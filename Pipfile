[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
flask = "*"
graphviz = "*"
utils = "*"
cors = "*"
flask-cors = "*"
flask-sqlalchemy = "*"
flask-migrate = "*"
flask-jwt-extended = "*"

[dev-packages]

[requires]
python_version = "3.12"

[scripts]
start = "python -m src.app"
env = "$env:FLASK_APP = 'manage.py'"
reset_db = "powershell -ExecutionPolicy Bypass -File ./docs/assets/reset_migrations.ps1"
